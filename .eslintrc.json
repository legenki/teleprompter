{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jquery": true,
    "serviceworker": true
  },
  "globals": {
    "TPColors": "readonly",
    "TPConfig": "readonly",
    "TelePrompter": "writable",
    "TelePrompterRemote": "writable",
    "QRCode": "readonly",
    "io": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "linebreak-style": ["error", "unix"],
    "eqeqeq": ["warn", "always"],
    "no-empty": ["warn", { "allowEmptyCatch": true }]
  },
  "ignorePatterns": [
    "node_modules/",
    "assets/css/",
    "assets/js/vendor.js",
    "assets/css/font-awesome.min.css"
  ]
}
